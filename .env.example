
GNANI_API_KEY=

# Base URL for every Gnani speech API. Leave as-is unless you are pointed at a
# staging host; the WebSocket URL is derived from it.
GNANI_BASE_URL=https://api.vachana.ai

# Hugging Face token, for pushing or pulling the generated dataset.
# Only needed by the data scripts, not by the benchmark or the dashboard.
HF_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Where Twilio can reach this backend from the internet. Twilio dials a
# WebSocket, so localhost is not enough:
#     cloudflared tunnel --url http://localhost:8000
# then paste the https URL it prints here. Changes every restart unless the
# tunnel is named.
PUBLIC_BASE_URL=

# Optional. Required to dial from anywhere other than this machine: with it
# set, POST /v1/twilio/dial needs an X-Sunvai-Key header. Without it, dialling
# is loopback-only -- which is the local demo, and nothing reachable through
# the tunnel. Set it if you expose the app.
SUNVAI_CONTROL_KEY=

# Optional. Signs the short-lived token in the stream URL, so an open tunnel is
# not an open audio sink spending Gnani credits. Defaults to the Twilio auth
# token, so you usually do not need this.
RELAY_STREAM_SECRET=
